<Application x:Class="AclLegibility.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:AclLegibility.Theme"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/HueTheme.xaml" />
                <!-- Theme/AclLegibility.Extras.xaml is added in App.OnStartup, after the kit is in place:
                     its styles derive from kit styles via StaticResource. -->
            </ResourceDictionary.MergedDictionaries>
            <theme:OriginTagStyleConverter x:Key="OriginTagStyle" />
            <theme:IconGeometryConverter x:Key="IconGeometry" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
