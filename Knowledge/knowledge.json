    { "id": "trustedinstaller", "sid": "S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464", "name": "NT SERVICE\\TrustedInstaller", "confidence": "documented", "explain": "The Windows Modules Installer service. It owns and fully controls operating-system files so that only servicing (Windows Update, feature installs) changes them; administrators must take ownership first. This is Windows Resource Protection." },
    { "id": "all-services", "sid": "S-1-5-80-0", "name": "NT SERVICE\\ALL SERVICES", "confidence": "documented", "explain": "Every service that has a service SID." },
    { "id": "service-sid", "sidPattern": "S-1-5-80-*", "name": "NT SERVICE\\<service>", "confidence": "documented", "explain": "A per-service SID (virtual account). Derived from the service name, so a permission for it applies to exactly that service. Created by Windows for its own services and by installers for theirs." },
    { "id": "virtual-machines", "sid": "S-1-5-83-0", "name": "NT VIRTUAL MACHINE\\Virtual Machines", "confidence": "documented", "explain": "All Hyper-V virtual machine worker processes." },
    { "id": "vm-sid", "sidPattern": "S-1-5-83-*", "name": "NT VIRTUAL MACHINE\\<vm>", "confidence": "documented", "explain": "One Hyper-V virtual machine: its account (S-1-5-83-1- followed by the VM id as four numbers). Hyper-V gives it full control on the VM's own files and read access on files attached to it (ISO images, disks), and does not remove the entry when the file is detached or the VM is deleted. After a scan of every drive, an account whose VM id has no <VM id>.vmcx anywhere is marked \"VM gone\"." },
    { "id": "vm-worker-capability", "sid": "S-1-15-3-1024-2268835264-3721307629-241982045-173645152-1490879176-104643441-2915960892-1612460704", "name": "Hyper-V VM worker process (capability)", "confidence": "documented", "explain": "The capability Hyper-V's VM worker process (vmwp.exe) runs with; named sidVmWorkerProcessCapability in Microsoft's go-winio code. Windows shows it as \"Account Unknown\" because a capability SID is a hash of a capability name, not an account. Hyper-V puts it next to the VM's own account on every file a VM uses; one entry serves all VMs." },
    { "id": "user-mode-drivers", "sid": "S-1-5-84-0-0-0-0-0", "name": "USER MODE DRIVERS", "confidence": "documented", "explain": "User-mode driver framework (UMDF) host processes." },
    { "id": "iis-apppool", "sidPattern": "S-1-5-82-*", "name": "IIS AppPool\\<pool>", "builtin": false, "origin": "custom", "confidence": "documented", "explain": "An IIS application pool identity (virtual account). The SID is derived from the pool name. Pools are created when sites are set up, so these permissions are configuration — the classic place where a working web server's ACL was tuned by hand." },
    { "id": "task-sid", "sidPattern": "S-1-5-87-*", "name": "NT TASK\\(task account, name not derived)", "confidence": "documented", "explain": "A scheduled task's own virtual account (authority S-1-5-87). Windows derives it from the task name like a service SID; the app names it only when a task in the store yields exactly this SID. Unnamed ones belong to a task whose name was not found or is derived differently." },
    { "id": "window-manager", "sidPattern": "S-1-5-90-*", "name": "Window Manager\\DWM-n", "confidence": "documented", "explain": "Desktop Window Manager per-session virtual accounts." },
    { "id": "winrm-virtual", "sidPattern": "S-1-5-94-*", "name": "WinRM Virtual Users", "confidence": "assumed", "explain": "Virtual accounts for PowerShell remoting / Just Enough Administration endpoints." },
    { "id": "font-driver-host", "sidPattern": "S-1-5-96-*", "name": "Font Driver Host\\UMFD-n", "confidence": "documented", "explain": "User-mode font driver host per-session accounts." },
    { "id": "restricted-services", "sidPattern": "S-1-5-99-*", "name": "Restricted service", "origin": "stock", "confidence": "assumed", "explain": "A per-service SID of the restricted-services authority (S-1-5-99): like NT SERVICE\\<name>, but for a service whose token is restricted. Windows creates these for its own hardened services and grants them only what that service needs; Windows cannot turn them into names, so they show as SIDs." },
    { "id": "local-account", "sid": "S-1-5-113", "name": "Local account", "confidence": "documented", "explain": "Any local (non-domain) account. Used to block local accounts from network logon." },
    { "id": "local-account-admin", "sid": "S-1-5-114", "name": "Local account and member of Administrators group", "confidence": "documented", "explain": "Local accounts that are administrators." },
    { "id": "logon-session", "sidPattern": "S-1-5-5-*", "name": "Logon session", "confidence": "documented", "explain": "Identifies one logon session. Seen on objects created for a single session; normally transient." },

    { "id": "all-app-packages", "sid": "S-1-15-2-1", "name": "ALL APPLICATION PACKAGES", "confidence": "documented", "explain": "Every AppContainer (Store/UWP apps, sandboxed browser processes). System folders grant it read & execute so sandboxed apps can load system DLLs." },
    { "id": "all-restricted-app-packages", "sid": "S-1-15-2-2", "name": "ALL RESTRICTED APPLICATION PACKAGES", "confidence": "documented", "explain": "Every less-privileged AppContainer (LPAC), e.g. the most locked-down browser sandboxes. Must be granted separately from ALL APPLICATION PACKAGES." },
