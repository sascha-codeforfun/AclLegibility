    { "id": "creator-owner", "sid": "S-1-3-0", "name": "CREATOR OWNER", "confidence": "documented", "explain": "A placeholder in inheritable entries. When a new file or folder is created, this entry is replaced by the account that created it. On the object itself it is inherit-only and grants nothing." },
