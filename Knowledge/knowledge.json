  // AclLegibility built-in knowledge base.
  // Confidence: documented = Microsoft documentation, observed = confirmed on a clean install,
  // assumed = written from experience but not yet confirmed, unverified = location known, ACL not compared.
  // Origin: stock = shipped/set by Windows; custom = admin/user/app activity; unknown = can't tell.
  // Override or extend any entry in knowledge.user.json next to the exe (same id replaces, "remove": true deletes).
  "version": 14,
  "description": "Windows 10, Windows 11, Server 2019, Server 2025. v2: first observed entry (C:\\ on Windows 11 build 26300), Trace origin, expected stock items. v3: system areas. v4: capabilities stock, restricted service SIDs. v5: compatibility links with their targets (a different target is Modified; a missing one is reported quietly). v6: crypto key stores; hard-link entries now see real link counts (0.1.6 and earlier read part of the file ID). v7: profile folders matched to their account through Windows' profile list ($PROFILE), isolatedWin32 capability; \"items\" explaining what a file or folder is (desktop.ini, defaultuser0, Default, Windows Error Reporting). v8: profile rule for folders only (\"kind\": \"dir\"); profiles of deleted accounts are leftovers (Trace); sparse files explained. v9: calibrated against a clean Windows 11 26H2 Pro install (build 26300): WindowsApps, Edge, AppRepository, Defender ATP, per-account layouts ($PROFILE, $ANYPROFILE, $NAMESID, $FILENAME, $ORPHAN tokens), 139 exact ACLs, image-build SIDs as known principals, compressed logs and caches as traces, profile junctions inherit. v10: known ACL variants of path entries; WDI StartupInfo files (stock, and removable leftovers of deleted accounts); registry transaction logs in profiles; Firefox and Mozilla Maintenance Service leftovers explained; TPM Endorsement Key cache variant. v11: Stock, per account for Windows' per-account layouts; WDI, Group Policy records, appcompat backup records, setup clean-up logs; Defender version folders and Hyper-V by rule; font cache streams; compressed language resources; explanations for MapData, DeviceSync, WinSxS, Diagnosis, PerceptionSimulation and app package caches; instructions split into reversible and not reversible. v12: the older duplicate entry for C:\\Documents and Settings removed (the observed legacy-junction-acl entry covers it); stock items and links that are not present are listed apart, never as findings. v14: calibrated against a clean Windows 10 22H2 Pro (build 19045): 98 Windows 11 entries hold there too, nine have a Windows 10 variant, eight places exist only on Windows 10, the Windows 10 image-build accounts are known, and $LOCALADMIN names this machine's built-in Administrator. v13: Hyper-V's VM worker-process capability named; files a VM uses or used (VM account plus that capability) are stock anywhere, and leftovers of deleted VMs are traces.",

  // Where Windows sets explicit permissions itself. Outside these, explicit entries for built-in
  // principals are Custom (set by hand or by an application). A list in knowledge.user.json replaces this one.
  "systemAreas": [
    "%SystemRoot%", "%ProgramFiles%", "%ProgramFiles(x86)%", "%ProgramData%", "%ProfilesDir%",
    "%SystemDrive%\\Recovery", "%SystemDrive%\\Boot", "%SystemDrive%\\EFI", "%SystemDrive%\\PerfLogs",
    "%SystemDrive%\\inetpub", "%SystemDrive%\\Documents and Settings",
    "?:\\System Volume Information", "?:\\$Recycle.Bin", "?:\\$WinREAgent", "?:\\$WINDOWS.~BT", "?:\\$Windows.~WS",
    "?:\\Config.Msi", "?:\\$SysReset", "?:\\$GetCurrent"
  ],

  "principals": [
    { "id": "image-build-administrator", "sid": "S-1-5-21-4024195226-107334468-2656468696-500", "name": "Image build machine\\Administrator", "builtin": true, "confidence": "observed",
      "explain": "The Administrator of the machine Microsoft builds the Windows installation image on. It is baked into the image: a few scheduled tasks (Application Experience\\StartupAppTask, Shell\\FamilySafetyRefreshTask) carry an entry for it on every installation from these media. No account on this machine uses it; the entry grants nothing. Part of Windows as shipped — not an orphan to clean up." },
    { "id": "image-build-guest", "sid": "S-1-5-21-4024195226-107334468-2656468696-501", "name": "Image build machine\\Guest", "builtin": true, "confidence": "observed",
      "explain": "The Guest of the machine Microsoft builds the Windows installation image on, baked into the image (a deny entry on ProgramData\\Microsoft\\DeviceSync). Part of Windows as shipped — not an orphan to clean up." },
    {"id":"image-build-win10-administrator","sid":"S-1-5-21-3933942852-973373972-2766786355-500","name":"Image build machine (Windows 10)\\Administrator","builtin":true,"confidence":"observed","explain":"The Administrator of a machine Microsoft builds the Windows 10 installation image on, baked into the image (scheduled task files such as StartupAppTask and FamilySafetyRefreshTask). Part of Windows as shipped — not an orphan to clean up."},
