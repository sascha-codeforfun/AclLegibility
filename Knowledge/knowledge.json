  "paths": [
    {
      "id": "crypto-rsa-machinekeys", "os": ["win10", "win11", "srv2019", "srv2025"],
      "path": "%ProgramData%\\Microsoft\\Crypto\\RSA\\MachineKeys",
      "owner": "SY", "protected": true, "mode": "exact", "confidence": "documented",
      "aces": ["A;;0x12019f;WD", "A;;F;BA"],
      "explain": "Store for machine-wide RSA private keys (CryptoAPI), one file per key container. Everyone may create files here (this folder only) so any process can save a machine key; each key file then gets its own protected entries for its creator. Administrators have full control of the folder only. Matches Microsoft's documented default permissions (seen identically on Windows 11 build 26300)."
    },
    {
      "id": "systemdrive-root-win11", "os": ["win11"], "path": "%SystemDrive%\\", "expected": true,
      "owner": "TI", "protected": true, "confidence": "observed",
      "aces": [
        "A;OICI;F;BA", "A;OICI;F;SY", "A;OICI;RX;BU", "A;OICIIO;M;AU", "A;;AD;AU",
        "A;;RD+X+RA+S;S-1-15-3-65536-1888954469-739942743-1668119174-2468466756-4239452838-1296943325-355587736-700089176;optional"
      ],
      "explain": "Root of the system drive (observed on Windows 11 build 26300). Owned by TrustedInstaller, inheritance disabled. Administrators and SYSTEM have full control; Users can read and run. Authenticated Users may create folders directly in the root (AD on this folder only), and an inherit-only Modify entry gives Authenticated Users Modify on everything below that inherits — Windows, Program Files and Users block this by disabling inheritance. Consequence worth knowing: any folder created in C:\\ by hand (C:\\Tools, C:\\Scripts…) is writable by every signed-in user unless tightened. A capability SID gets list/traverse on the root itself so less-privileged app containers can resolve paths; an inherit-only High integrity label (no write-up) keeps unelevated processes from writing below unless the DACL is explicit."
    },
    {
      "id": "systemdrive-root-win10", "os": ["win10"], "path": "%SystemDrive%\\", "expected": true,
      "confidence": "assumed",
      "aces": ["A;OICI;F;BA", "A;OICI;F;SY", "A;OICI;RX;BU", "A;OICIIO;M;AU", "A;;AD;AU"],
      "explain": "Root of the system drive. Administrators and SYSTEM have full control; Users can read and run. Authenticated Users may create folders directly in the root (AD on this folder only), and an inherit-only Modify entry gives Authenticated Users Modify on everything below that inherits — Windows, Program Files and Users block this by disabling inheritance. Consequence worth knowing: any folder created in C:\\ by hand is writable by every signed-in user unless tightened."
    },
    {
      "id": "systemdrive-root-server", "os": ["srv2019", "srv2022", "srv2025"], "path": "%SystemDrive%\\", "expected": true,
      "confidence": "assumed",
      "aces": ["A;OICI;F;BA", "A;OICI;F;SY", "A;OICIIO;F;CO", "A;OICI;RX;BU", "A;CI;AD;BU", "A;CIIO;WD;BU"],
      "explain": "Root of the system drive, server layout (the classic pre-Windows-10 ACL). Users can read; they may create folders (AD, inherited by subfolders) and create files inside subfolders (inherit-only WD), and CREATOR OWNER gives the creator full control of what they made — but not of other people's files. This is why folders an admin creates in C:\\ on a server let users drop files in them unless tightened."
    },
    {
      "id": "other-volume-root", "path": "?:\\",
