  "patterns": [
    {"id": "grouppolicy-user-record-leftover", "under": ["%ProgramData%\\Microsoft\\GroupPolicy\\Users\\*"], "principals": ["SY", "BA", "$ORPHAN"], "origin": "trace", "confidence": "observed", "explain": "Group Policy's record for one account: ntuser.pol lists the registry policies Group Policy applied to that account (from local policy or a domain), so it can remove them again when a policy is withdrawn. SYSTEM and Administrators have full control; the account may read its own record. The policies themselves are listed under Known. This one belongs to an account that no longer exists: a leftover."},
    {"id": "grouppolicy-user-record", "under": ["%ProgramData%\\Microsoft\\GroupPolicy\\Users\\*"], "principals": ["SY", "BA", "$NAMESID"], "origin": "peraccount", "confidence": "observed", "explain": "Group Policy's record for one account: ntuser.pol lists the registry policies Group Policy applied to that account (from local policy or a domain), so it can remove them again when a policy is withdrawn. SYSTEM and Administrators have full control; the account may read its own record. The policies themselves are listed under Known."},
    {"id": "appcompat-backup-leftover", "under": ["%SystemRoot%\\appcompat\\Backup"], "principals": ["SY", "BA", "$ORPHAN"], "origin": "trace", "confidence": "observed", "removable": true, "explain": "A per-account record under Windows' application-compatibility folder: one JSON file per account SID with three lists — Install, Update, Uninstall. It reads like bookkeeping of app installs for that account (for backup and restore of the app list); empty lists mean nothing is tracked. The purpose follows from name and content; it is not documented. This file belongs to an account that no longer exists: a leftover, safe to delete."},
    {"id": "appcompat-backup", "under": ["%SystemRoot%\\appcompat\\Backup"], "principals": ["SY", "BA", "$NAMESID"], "origin": "peraccount", "confidence": "assumed", "explain": "A per-account record under Windows' application-compatibility folder: one JSON file per account SID with three lists — Install, Update, Uninstall. It reads like bookkeeping of app installs for that account (for backup and restore of the app list); empty lists mean nothing is tracked. The purpose follows from name and content; it is not documented."},
    {"id": "setupcln-logs-leftover", "under": ["%SystemRoot%\\System32\\LogFiles\\setupcln"], "principals": ["SY", "BA", "LS", "$ORPHAN"], "origin": "trace", "confidence": "observed", "removable": true, "explain": "Logs of Windows Setup's clean-up — the step that removes what an upgrade leaves behind (Windows.old, temporary setup files), run by Disk Cleanup (\"Previous Windows installation(s)\") or by Windows itself after an upgrade: setupact.log (everything), setuperr.log (errors), diagerr.xml and diagwrn.xml (errors and warnings as structured diagnostics). Each file grants the account the clean-up ran under; the next run rewrites them. Here that account no longer exists. Safe to delete — the next clean-up run writes the logs fresh."},
    {"id": "setupcln-logs", "under": ["%SystemRoot%\\System32\\LogFiles\\setupcln"], "principals": ["SY", "BA", "LS", "$ANYPROFILE"], "origin": "peraccount", "confidence": "assumed", "explain": "Logs of Windows Setup's clean-up — the step that removes what an upgrade leaves behind (Windows.old, temporary setup files), run by Disk Cleanup (\"Previous Windows installation(s)\") or by Windows itself after an upgrade: setupact.log (everything), setuperr.log (errors), diagerr.xml and diagwrn.xml (errors and warnings as structured diagnostics). Each file grants the account the clean-up ran under; the next run rewrites them."},
    {"id": "defender-version-folders", "under": ["%ProgramData%\\Microsoft\\Windows Defender\\Definition Updates", "%ProgramData%\\Microsoft\\Windows Defender\\Platform", "%ProgramData%\\Microsoft\\Windows Defender\\Models", "%ProgramData%\\Microsoft\\Windows Defender\\Scans"], "owners": ["SY", "TI", "BA"], "principals": ["TI", "SY", "BA", "BU", "NS", "LS", "CO", "AC", "RAC", "S-1-15-2-*", "S-1-15-3-*", "S-1-5-80-*"], "origin": "stock", "confidence": "assumed", "explain": "Microsoft Defender's own data: signature packages (Definition Updates\\{GUID}), engine and platform versions (Platform\\4.18.…), detection models and scan history. These folders are named by version, so every machine has different names and no exact entry can match them; this rule accepts Defender's layout — owned by SYSTEM or TrustedInstaller, only built-in principals, service and capability SIDs. Rights are not compared: anything that names an ordinary account here falls through to the other rules."},
    {"id": "hyperv-attached-leftover", "principals": ["S-1-15-3-1024-2268835264-3721307629-241982045-173645152-1490879176-104643441-2915960892-1612460704", "$VMGONE"], "origin": "trace", "confidence": "observed", "explain": "A file a Hyper-V VM used (an ISO image, an answer ISO, a disk or the VM's own files): Hyper-V gave the VM's account and its worker-process capability access when it attached the file, and did not remove them when the file was detached or the VM deleted. The VM no longer exists on this machine (no <VM id>.vmcx on any drive), so its entry is a leftover. The capability entry is shared by all VMs. AclLegibility only explains these entries; removing them is up to the tool that manages the VMs, or to you."},
    {"id": "hyperv-attached", "principals": ["S-1-15-3-1024-2268835264-3721307629-241982045-173645152-1490879176-104643441-2915960892-1612460704", "S-1-5-83-1-*"], "origin": "stock", "confidence": "observed", "explain": "A file a Hyper-V VM uses or used: Hyper-V adds two explicit entries when it attaches a file to a VM, so its worker process can open it — the VM's own account (NT VIRTUAL MACHINE\\<VM id>; read on an attached ISO or disk, full control on the VM's own files) and the VM worker-process capability. Hyper-V does not remove them when the file is detached or the VM is deleted: on a file many VMs have used, one VM-account entry per VM stays behind (marked \"VM gone\" once the VM no longer exists). Observed on Windows 11 26H2 with an ISO attached to a VM's DVD drive."},
    {"id": "hyperv-store", "under": ["%ProgramData%\\Microsoft\\Windows\\Hyper-V", "%ProgramData%\\Microsoft\\Windows\\Virtual Hard Disks"], "principals": ["SY", "BA", "S-1-5-32-578", "S-1-5-83-*", "CO", "OW", "AU", "BU", "S-1-5-80-*"], "origin": "stock", "confidence": "assumed", "explain": "Set by Windows when the Hyper-V feature is enabled. The Virtual Machine Management Service (vmms) keeps its configuration store here — data.vmcx, Resource Types, and caches of VMs, groups and checkpoints — and Virtual Hard Disks is the default place for new disks. Hyper-V Administrators (S-1-5-32-578) and virtual machine accounts (NT VIRTUAL MACHINE, S-1-5-83-…) are the feature's own principals. Rule only: rights are not compared; a clean install with Hyper-V enabled has not been calibrated yet."},
    {"id": "wdi-startupinfo-leftover", "under": ["%SystemRoot%\\System32\\WDI\\LogFiles\\StartupInfo"], "owners": ["LS"], "principals": ["$ORPHAN"], "origin": "trace", "confidence": "observed", "removable": true, "explain": "Windows Diagnostic Infrastructure (the Diagnostic Policy Service, running as LOCAL SERVICE) records at every sign-in which programs start for that account; Task Manager's \"Startup impact\" comes from these files. It keeps up to five per account SID (<SID>_StartupInfo1.xml to 5, overwritten in turn) and gives that account access to its own files. The service never deletes them when an account is deleted, so these belong to an account that no longer exists: a leftover. Safe to delete — the service writes new files only for accounts that still sign in."},
    {"id": "wdi-startupinfo", "under": ["%SystemRoot%\\System32\\WDI\\LogFiles\\StartupInfo"], "owners": ["LS"], "principals": ["$NAMESID"], "origin": "peraccount", "confidence": "observed", "explain": "Windows Diagnostic Infrastructure (the Diagnostic Policy Service, running as LOCAL SERVICE) records at every sign-in which programs start for that account; Task Manager's \"Startup impact\" comes from these files. It keeps up to five per account SID (<SID>_StartupInfo1.xml to 5, overwritten in turn) and gives that account access to its own files."},
    {"id": "profile-registry-txr-logs", "under": ["%ProfilesDir%\\*\\NTUSER.DAT{*}.TM*", "%ProfilesDir%\\*\\AppData\\Local\\Microsoft\\Windows\\UsrClass.dat{*}.TM*"], "owners": ["SY", "BA"], "principals": ["SY", "BA", "BU", "$PROFILE"], "origin": "stock", "confidence": "observed", "explain": "Registry transaction logs (Common Log File System) for the hive next to them: a .TM.blf log and its .regtrans-ms containers. Windows creates them when a process loads the hive with transaction support — setup, an in-place upgrade, a new account copied from Default. The GUID in the name is the log's identity; it is a version-1 GUID, so it holds the moment it was made (see Known). A new set next to an old one means the hive was loaded again later and got a new log; the old set is not removed. The .cnpf files appear only next to newer sets; what they hold is not documented, so this entry claims nothing about them."},
    {
      "id": "crypto-machinekeys-service-keys", "under": ["%ProgramData%\\Microsoft\\Crypto\\RSA\\MachineKeys"],
      "owners": ["SY"], "principals": ["SY", "OW", "BA", "S-1-5-80-*"], "origin": "trace", "confidence": "assumed",
      "explain": "Private-key container of a Windows service (CryptoAPI machine key). The creating service gets full control, OWNER RIGHTS only read-permissions, so no one else - not even Administrators - can read the key. The name is a hash of the container name, an underscore and this machine's GUID. Main source on Hyper-V hosts: every VM with a virtual TPM leaves one such file per VM start and then one every 5 minutes while it runs (NT SERVICE\\HgClientService; 288 a day per running VM, observed on Windows 11 26H2), and nothing removes them - not even deleting the VM. Files no certificate uses are safe to remove once no vTPM VM is running. Key files created by a user account are not covered here, so they stay visible."
    },
    {
      "id": "crypto-cng-machine-keys", "under": ["%ProgramData%\\Microsoft\\Crypto\\Keys", "%ProgramData%\\Microsoft\\Crypto\\SystemKeys", "%ProgramData%\\Microsoft\\Crypto\\RSA\\S-1-5-18"],
