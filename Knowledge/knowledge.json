    { "id": "owner-rights", "sid": "S-1-3-4", "name": "OWNER RIGHTS", "confidence": "documented", "explain": "Represents the current owner. Normally the owner implicitly may read and change permissions; an OWNER RIGHTS entry replaces that implicit right with exactly what it grants." },
