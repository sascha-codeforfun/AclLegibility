<Window x:Class="AclLegibility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AclLegibility.ViewModels"
        xmlns:busy="clr-namespace:BusyOverlayKit"
        Style="{StaticResource Hue.Window}"
        Title="AclLegibility" Width="1600" Height="950" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- List text for a row holding an explicit Deny for a broad group (Everyone, Users, SYSTEM, …): error colour. -->
        <Style x:Key="App.BroadDenyText" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding BroadDeny}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Origin tag in list cells: one width for all, text centred (fits "Stock, modified"). -->
        <DataTemplate x:Key="OriginCell">
            <ContentControl Style="{Binding Origin, Converter={StaticResource OriginTagStyle}}"
                            Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                <TextBlock Text="{Binding OriginLabel}" Width="96" TextAlignment="Center" TextTrimming="None" />
            </ContentControl>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- header  -->
            <RowDefinition Height="Auto" />  <!-- actions -->
            <RowDefinition Height="*" />     <!-- body    -->
            <RowDefinition Height="Auto" />  <!-- status  -->
        </Grid.RowDefinitions>

        <!-- ===== Header: identity · live pill · OS block, version block ===== -->
        <Border Grid.Row="0" Style="{StaticResource Hue.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <ContentControl Style="{StaticResource Hue.IconGlow}" Width="64" Height="64" Cursor="Hand"
                                    MouseLeftButtonUp="Logo_Click" ToolTip="What the actions change — the terms">
                        <Image Source="pack://application:,,,/Assets/app_256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </ContentControl>
                    <StackPanel Margin="18,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="AclLegibility" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="See every permission, stream and filesystem quirk on this machine, and what's stock versus custom." />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl x:Name="ScanPill" Style="{StaticResource Hue.Pill.Stale}" FontFamily="{StaticResource Font.Mono}"
                                    MinWidth="120" Visibility="Collapsed" Content="Scan 00:00" />
                    <Button x:Name="GrantNotice" Style="{StaticResource Hue.Button.Danger}" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="GrantNotice_Click" Content="Explorer grants"
                            ToolTip="Folders where Explorer's &quot;Continue&quot; left a permanent full-control entry. Click to list them." />
                    <Button x:Name="SxsNotice" Style="{StaticResource Hue.Button.Ghost}" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="SxsNotice_Click" Content="WinSxS"
                            ToolTip="Older component versions in Windows' component store. Click to see them and the clean-up." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                    <!-- OS block -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="OsTitle" Style="{StaticResource Text.Version}" Text="Windows" />
                        <TextBlock x:Name="OsCaption" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" TextAlignment="Right" />
                        <ContentControl x:Name="TargetPill" Style="{StaticResource Hue.Pill.Stale}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                        Content="checking OS" />
                    </StackPanel>
                    <Border Style="{StaticResource Hue.Divider}" />
                    <!-- version block -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Version}" />
                        <TextBlock x:Name="KbCaption" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" TextAlignment="Right" />
                        <ContentControl x:Name="ReadOnlyPill" Style="{StaticResource Hue.Pill.Warn}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                        Content="read only" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ReadOnlyPill_Click"
                                        ToolTip="The actions that change this machine are off until you agree. Click to read and decide." />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Actions ===== -->
        <Border Grid.Row="1" Padding="24,12" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
            <!-- Clean-ups that work without a scan: run them first, so a full scan does not read what they remove. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <!-- Rim for pointing at this button from the WinSxS details: amber on purpose, outside the theme kit (see README,
                     Theme deviations). Transparent and pulled in by its own width otherwise, so the layout does not move. -->
                <Border x:Name="SxsCleanRim" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" Margin="-2">
                    <Button x:Name="SxsCleanButton" Content="Component store clean-up…" Click="ComponentCleanup_Click"
                            ToolTip="Windows' own clean-up of superseded component versions in WinSxS (dism.exe /StartComponentCleanup). Works without a scan — run it before a full scan." />
                </Border>
                <Button x:Name="AppVersionsButton" Content="Superseded app versions…" Click="AppVersions_Click" Margin="10,0,0,0"
                        ToolTip="Older versions of app packages in WindowsApps, which DISM does not clean. Asks Windows who still uses each one, then shows a preview. Works without a scan." />
            </StackPanel>
            <!-- Every item keeps 8 px below it and the row takes it back (-8), so one line looks as before and wrapped lines do not touch. -->
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-8">
                <Button x:Name="ScanAllButton" Style="{StaticResource Hue.Button.Primary}" Content="Scan Disks" Click="ScanAll_Click" Margin="0,0,0,8"
                        ToolTip="Reads every file and folder on all fixed volumes. Junctions and symlinks are recorded but not followed." />
                <Button x:Name="ScanFolderButton" Content="Scan Folder" Click="ScanFolder_Click" Margin="10,0,0,8" />
                <Border Style="{StaticResource Hue.Divider}" Margin="20,4,20,12" />
                <Button x:Name="OpenSnapButton" Content="Open snapshot…" Click="OpenSnapshot_Click" Margin="0,0,0,8"
                        ToolTip="Open a .aclsnap file saved earlier, e.g. a scan of another machine or a clean VM." />
                <Button x:Name="SaveSnapButton" Content="Save snapshot…" Click="SaveSnapshot_Click" IsEnabled="False" Margin="10,0,0,8"
                        ToolTip="Saves raw descriptors, names and OS facts. Contains real, unmasked names." />
                <Button x:Name="CompareSnapButton" Content="Compare Snapshot" Click="CompareSnapshot_Click" IsEnabled="False" Margin="10,0,0,8"
                        ToolTip="Compare the current scan with an earlier snapshot and list only what changed (Changes tab)." />
                <Border Style="{StaticResource Hue.Divider}" Margin="20,4,20,12" />
                <Button x:Name="ReloadKbButton" Style="{StaticResource Hue.Button.Ghost}" Content="Reload knowledge" Click="ReloadKb_Click" Margin="0,0,0,8"
                        ToolTip="Re-reads knowledge.user.json next to the exe and re-classifies the current scan without rescanning." />
                <Button Style="{StaticResource Hue.Button.Ghost}" Content="Open app folder" Click="OpenAppFolder_Click" Margin="6,0,0,8"
                        ToolTip="Folder with AclLegibility.json and knowledge.user.json" />
                <Border Style="{StaticResource Hue.Divider}" Margin="20,4,20,12" />
                <CheckBox x:Name="MaskCheck" Style="{StaticResource Hue.Switch}" Content="Mask names in Copy for AI" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,0,8"
                          ToolTip="Replaces computer, domain and account names with placeholders. Accounts listed in AclLegibility.json (default User, ElevatedUser) stay readable." />
            </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Body ===== -->
        <TabControl x:Name="Tabs" Grid.Row="2">

            <!-- Explorer -->
            <TabItem Header="Explorer">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" MinWidth="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="1.25*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Hue.Button.Ghost}" Content="+" Click="ExpandAll_Click" MinWidth="32" Padding="8,2"
                                            ToolTip="Expand the selected branch completely (the whole tree if nothing is selected); stops at 5,000 rows"
                                            AutomationProperties.Name="Expand all" />
                                    <Button Style="{StaticResource Hue.Button.Ghost}" Content="−" Click="CollapseAll_Click" MinWidth="32" Padding="8,2"
                                            ToolTip="Collapse the whole tree back to the drives"
                                            AutomationProperties.Name="Collapse all" />
                                </StackPanel>
                                <CheckBox x:Name="OnlyAttentionCheck" Style="{StaticResource Hue.Switch}" Content="Only branches with findings" IsChecked="True"
                                          Checked="OnlyAttention_Changed" Unchecked="OnlyAttention_Changed" VerticalAlignment="Center"
                                          ToolTip="Hide folders where everything below is stock or a trace." />
                            </DockPanel>
                        </Border>
                        <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemVm}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                        <StackPanel Orientation="Horizontal" Style="{StaticResource App.LinkAware}">
                                            <Path Style="{StaticResource Hue.Icon}" Data="{Binding IconKey, Converter={StaticResource IconGeometry}}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ContentControl Style="{StaticResource Hue.Tag.Unsafe}" Content="broad Deny"
                                                        Margin="8,0,0,0" Visibility="{Binding HasBroadDeny, Converter={StaticResource BoolToVis}}" />
                                        <ContentControl Style="{StaticResource Hue.Tag.Unsafe}" Content="{Binding ModifiedBadge}"
                                                        Margin="8,0,0,0" Visibility="{Binding HasModified, Converter={StaticResource BoolToVis}}" />
                                        <ContentControl Style="{Binding RestWorst, Converter={StaticResource OriginTagStyle}}" Content="{Binding RestBadge}"
                                                        Margin="6,0,0,0" Visibility="{Binding HasRest, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.LineSoft}" />

                    <DataGrid x:Name="ContentGrid" HorizontalScrollBarVisibility="Auto" ColumnWidth="Auto" FrozenColumnCount="2" Grid.Column="2" Style="{StaticResource Hue.DataGrid.Compact}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended"
                              SelectionChanged="ContentGrid_SelectionChanged" MouseDoubleClick="ContentGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy for AI" Click="CtxCopyAi_Click" />
                                <MenuItem Header="Copy for AI, including findings below" Click="CtxCopyAiSubtree_Click" />
                                <MenuItem Header="Copy path" Click="CtxCopyPath_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="This object" Width="132" SortMemberPath="Origin" CellTemplate="{StaticResource OriginCell}" />
                            <DataGridTemplateColumn Header="Name" Width="Auto" MinWidth="160" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Style="{StaticResource App.LinkAware}">
                                            <Path Style="{StaticResource Hue.Icon}" Data="{Binding IconKey, Converter={StaticResource IconGeometry}}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Findings" Binding="{Binding FindingsText}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource App.BroadDenyText}" />
                            <DataGridTextColumn Header="Below" Binding="{Binding Below}" Width="Auto" MinWidth="70" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="Auto" MinWidth="70" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="Auto" MinWidth="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.LineSoft}" />

                    <ScrollViewer x:Name="ExplorerDetails" Grid.Column="4" Padding="24,12,24,24"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </TabItem>

            <!-- Findings -->
            <TabItem Header="Findings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="20,12" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="ORIGIN" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                            <WrapPanel x:Name="OriginChips" Margin="0,0,0,10" />
                            <TextBlock Text="KIND" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                            <WrapPanel x:Name="CategoryChips" Margin="0,0,0,10" />
                            <StackPanel x:Name="CausePanel" Visibility="Collapsed">
                                <TextBlock Text="UNREADABLE CAUSE" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                                <WrapPanel x:Name="CauseChips" Margin="0,0,0,10" />
                            </StackPanel>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,6">
                                    <Path Style="{StaticResource Hue.Icon}" Data="{StaticResource Icon.Search}" Margin="0,0,8,0" />
                                    <TextBox x:Name="FText" Width="320" TextChanged="FilterText_Changed"
                                             AutomationProperties.Name="Search path, summary or knowledge entry"
                                             ToolTip="Search path, summary or knowledge entry" />
                                    <TextBlock x:Name="FindingCount" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource Hue.Button.Tonal}" Content="Copy for AI (filtered)" Click="CopyFiltered_Click" Margin="0,0,10,6" />
                                <Button Content="Save filtered as Markdown…" Click="SaveFiltered_Click" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" MinWidth="340" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" MinWidth="340" />
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="FindingsGrid" HorizontalScrollBarVisibility="Auto" ColumnWidth="Auto" Grid.Column="0" Style="{StaticResource Hue.DataGrid.Compact}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Extended"
                                  SelectionChanged="FindingsGrid_SelectionChanged" MouseDoubleClick="FindingsGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy selected for AI" Click="CopySelectedFindings_Click" />
                                    <MenuItem Header="Show in Explorer tab" Click="RevealFinding_Click" />
                                    <MenuItem Header="Copy path" Click="CopyFindingPath_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Origin" Width="132" SortMemberPath="Origin" CellTemplate="{StaticResource OriginCell}" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Category}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource App.BroadDenyText}" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Knowledge" Binding="{Binding KbId}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="Auto" MinWidth="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.LineSoft}" />
                        <ScrollViewer x:Name="FindingDetails" Grid.Column="2" Padding="24,12,24,24"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Accounts & groups -->
            <TabItem Header="Accounts &amp; groups">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="340" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Top" Padding="20,12" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <Path Style="{StaticResource Hue.Icon}" Data="{StaticResource Icon.Search}" Margin="0,0,8,6" VerticalAlignment="Center" />
                                <TextBox x:Name="PrincipalFilter" Margin="0,0,0,6" Width="280" TextChanged="PrincipalFilter_Changed"
                                         AutomationProperties.Name="Search name, SID or kind" ToolTip="Search name, SID or kind" />
                                <CheckBox x:Name="PrincipalReferencedOnly" Style="{StaticResource Hue.Switch}" Margin="20,0,0,6" VerticalAlignment="Center"
                                          Content="Only those with explicit entries" Click="PrincipalFilter_Changed" />
                                <CheckBox x:Name="PrincipalOrphansOnly" Style="{StaticResource Hue.Switch}" Margin="20,0,0,6" VerticalAlignment="Center"
                                          Content="Only orphaned or unverifiable SIDs" Click="PrincipalFilter_Changed"
                                          ToolTip="SIDs of accounts that no longer exist (proven) or could not be checked." />
                                <Button x:Name="CleanAllButton" Content="Clean up all proven orphans…" Click="CleanAll_Click" Margin="20,0,0,6" IsEnabled="False"
                                        ToolTip="Replaces orphaned owners with Administrators and removes entries for proven orphaned SIDs. Shows a preview first." />
                            </WrapPanel>
                        </Border>
                        <DataGrid x:Name="PrincipalGrid" HorizontalScrollBarVisibility="Auto" ColumnWidth="Auto" Style="{StaticResource Hue.DataGrid.Compact}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                  SelectionChanged="PrincipalGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Origin" Width="132" SortMemberPath="Origin" CellTemplate="{StaticResource OriginCell}" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Explicit on" Binding="{Binding ExplicitText}" Width="Auto" MinWidth="70" SortMemberPath="ExplicitCount" />
                                <DataGridTextColumn Header="Owner of" Binding="{Binding OwnerText}" Width="Auto" MinWidth="70" SortMemberPath="OwnerCount" />
                                <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="Auto" MinWidth="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.LineSoft}" />
                    <ScrollViewer x:Name="PrincipalDetails" Grid.Column="2" Padding="24,12,24,24"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </TabItem>

            <!-- Shares -->
            <TabItem Header="Shares">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="340" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Top" Padding="20,12" BorderBrush="{DynamicResource Brush.LineSoft}" BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <Button Style="{StaticResource Hue.Button.Tonal}" Content="Copy all shares for AI" Click="CopyShares_Click" />
                            </WrapPanel>
                        </Border>
                        <DataGrid x:Name="ShareGrid" HorizontalScrollBarVisibility="Auto" ColumnWidth="Auto" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                  SelectionChanged="ShareGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Origin" Width="132" SortMemberPath="Origin" CellTemplate="{StaticResource OriginCell}" />
                                <DataGridTextColumn Header="Share" Binding="{Binding Name}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="Auto" MinWidth="70" />
                                <DataGridTextColumn Header="Remark" Binding="{Binding Remark}" Width="Auto" MinWidth="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.LineSoft}" />
                    <ScrollViewer x:Name="ShareDetails" Grid.Column="2" Padding="24,12,24,24"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </TabItem>

            <!-- Risks -->
            <TabItem x:Name="RisksTab" Header="Risks">
                <ScrollViewer x:Name="RisksInfo" Padding="28,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </TabItem>

            <!-- Knowledge base -->
            <TabItem x:Name="ChangesTab" Header="Changes" Visibility="Collapsed">
                <ScrollViewer x:Name="ChangesView" Padding="28,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </TabItem>
            <TabItem Header="Knowledge base">
                <ScrollViewer x:Name="KnowledgeInfo" Padding="28,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </TabItem>
        </TabControl>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Style="{StaticResource Hue.StatusBar}">
            <StackPanel Orientation="Horizontal">
                <ContentControl x:Name="StatusDot" Style="{StaticResource Hue.Marker}" Foreground="{DynamicResource Brush.Ok}" />
                <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Ready. Start with “Scan Disks” or open a snapshot." />
            </StackPanel>
        </Border>

        <busy:BusyOverlay x:Name="Busy" Grid.RowSpan="4" AnimateOverride="True" />
    </Grid>
</Window>
